<IfModule mod_headers.c>
  # Low-risk baseline headers for the static site.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=86400"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; worker-src 'self'; child-src 'self'; upgrade-insecure-requests"
</IfModule>

# Redirect the deprecated /new/ path prefix to the root site.
# (Kept for users who followed the preview URL.)
RedirectMatch 301 ^/new/(.*)$ https://nitta-kashiho.com/$1
RedirectMatch 301 ^/new$ https://nitta-kashiho.com/
