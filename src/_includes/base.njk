<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta
      name="description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。チーズケーキ、サブレ、まんじゅうなど、ジャージー牛乳たっぷりの手作りお菓子をお届けします。' }}"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ヒルゼンのお菓子屋 新田菓子舗" />
    <meta
      property="og:title"
      content="{% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      property="og:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      property="og:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />
    <meta property="og:url" content="{{ page.url | url }}" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="{% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      name="twitter:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      name="twitter:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />

    <title>
      {% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗
    </title>

    <link rel="stylesheet" href="/assets/css/global.css" />
    <link rel="stylesheet" href="/assets/fonts/line-seed-jp.css" />
    <link rel="icon" type="image/jpg" href="/assets/img/ushi_cyan.jpg" />

    {% if hasMap %}
      <!-- MapLibre GL JS -->
      <link
        rel="stylesheet"
        href="/assets/vendor/maplibre-gl/maplibre-gl.css"
      />
    {% endif %}

    <script src="/assets/js/alpine-init.js" type="module"></script>
  </head>

  <body>
    {{ content | safe }}
    {% include 'footer.liquid' %}

    {% if page.url != "/" %}
      <a
        href="/"
        aria-label="トップページへ"
        class="js-home-link bg-spring-900 hover:bg-spring-800 focus-visible:outline-spring-700 fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-4 z-20 inline-flex size-12 items-center justify-center rounded-full text-white shadow-md transition focus-visible:outline-3 focus-visible:outline-offset-3 motion-reduce:transition-none"
      >
        <svg
          aria-hidden="true"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
        </svg>
      </a>
      <script src="/assets/js/home-link.js" type="module"></script>
    {% endif %}

    {% if eleventy.env.runMode == "serve" %}
      {% include 'debug.liquid' %}
    {% endif %}
  </body>
</html>
