<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta
      name="description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。チーズケーキ、サブレ、まんじゅうなど、ジャージー牛乳たっぷりの手作りお菓子をお届けします。' }}"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ヒルゼンのお菓子屋 新田菓子舗" />
    <meta
      property="og:title"
      content="{% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      property="og:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      property="og:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />
    <meta property="og:url" content="{{ page.url | url }}" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="{% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      name="twitter:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      name="twitter:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />

    <title>
      {% if title %}{{ title }} -{% endif %}ヒルゼンのお菓子屋 新田菓子舗
    </title>

    <link rel="stylesheet" href="{{ env.siteUrl }}/assets/css/global.css" />
    <link
      rel="stylesheet"
      href="{{ env.siteUrl }}/assets/fonts/line-seed-jp.css"
    />
    <link rel="icon" type="image/jpg" href="/assets/img/ushi_cyan.jpg" />

    {% if hasMap %}
      <!-- MapLibre GL JS -->
      <link
        rel="stylesheet"
        href="{{ env.siteUrl }}/assets/vendor/maplibre-gl/maplibre-gl.css"
      />
      <script src="{{ env.siteUrl }}/assets/vendor/maplibre-gl/maplibre-gl.js"></script>
    {% endif %}

    <!-- Alpine.js -->
    <script
      src="{{ env.siteUrl }}/assets/vendor/alpinejs/cdn.min.js"
      defer
    ></script>
    <script
      src="{{ env.siteUrl }}/assets/js/img-onerror.mjs"
      type="module"
    ></script>
  </head>

  <body>
    <!-- Legacy site header banner -->
    <div class="w-full bg-stone-100 border-b border-stone-200 px-4 py-2 text-center">
      <a
        href="https://legacy.nitta-kashiho.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-xs font-medium text-stone-700 hover:text-stone-900 hover:underline"
      >
        <span>🏛️</span>
        <span>旧サイト（legacy.nitta-kashiho.com）はこちら</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-10L10 14" />
        </svg>
      </a>
    </div>

    {{ content | safe }}
    {% include 'footer.liquid' %}

    {% if eleventy.env.runMode == "serve" %}
      {% include 'debug.liquid' %}
    {% endif %}
  </body>
</html>
