<section class="px-4 py-12 max-w-5xl mx-auto">
  <h2 class="mb-2 text-2xl font-semibold text-center">終売商品の記録</h2>
  <p class="mb-8 text-center text-sm text-gray-500">
    かつて新田菓子舗で販売していた商品たちです。お客様との思い出とともに、ここで残しております。
  </p>

  {% assign grouped = products.discontinued | group_by: "category" %}

  {% for group in grouped %}
    <div class="mb-12 last:mb-0">
      <h3 class="mb-4 text-lg font-medium text-koshian-700 border-b border-koshian-200 pb-2">
        {{ group.name }}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {% for item in group.items %}
          <div class="flex flex-row bg-white rounded-xl shadow-md overflow-hidden border border-koshian-100 opacity-80 hover:opacity-100 transition-opacity">
            <div class="w-1/3 shrink-0 overflow-hidden bg-koshian-50">
              <picture>
                <source srcset="{{ item.image | webp }}" type="image/webp">
                <img
                  src="{{ item.image | prepend: '/' }}"
                  alt="{{ item.name }}"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.closest('picture').style.display='none'; this.closest('.w-1\/3').classList.add('placeholder')"
                >
              </picture>
            </div>
            <div class="flex flex-col justify-between p-3 w-2/3">
              <div>
                <h4 class="text-sm font-medium text-gray-900 mb-1">{{ item.name }}</h4>
                {% if item.note %}
                  <div class="text-[10px] text-baked-500 mb-1">{{ item.note }}</div>
                {% endif %}
              </div>
              {% if item.description %}
              <div class="mt-2">
                <p class="text-xs text-gray-500 leading-relaxed">{{ item.description }}</p>
              </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</section>
