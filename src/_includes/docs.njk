<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta
      name="description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ヒルゼンのお菓子屋 新田菓子舗" />
    <meta
      property="og:title"
      content="{{ title }} - ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      property="og:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      property="og:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />
    <meta property="og:url" content="{{ page.url | url }}" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="{{ title }} - ヒルゼンのお菓子屋 新田菓子舗"
    />
    <meta
      name="twitter:description"
      content="{{ metaDescription or '蒜山高原の特産品を使った洋菓子・和菓子の製造・販売。' }}"
    />
    <meta
      name="twitter:image"
      content="{{ ogImage or '/assets/img/souffle.jpg' }}"
    />

    <title>{{ title }} - ヒルゼンのお菓子屋 新田菓子舗</title>

    <link rel="stylesheet" href="{{ env.siteUrl }}/assets/css/global.css" />
    <link
      rel="stylesheet"
      href="{{ env.siteUrl }}/assets/fonts/line-seed-jp.css"
    />
    <link rel="icon" type="image/jpg" href="/assets/img/ushi_cyan.jpg" />

    <!-- Alpine.js -->
    <script
      src="{{ env.siteUrl }}/assets/vendor/alpinejs/cdn.min.js"
      defer
    ></script>
    <script
      src="{{ env.siteUrl }}/assets/js/img-onerror.mjs"
      type="module"
    ></script>
  </head>

  <body>
    <section class="document-container">
      <div class="document-title-column">
        <h1 class="document-title writing-vertical-rl">{{ title }}</h1>
      </div>
      <article class="document-body" aria-label="{{ title }}の本文">
        <div class="document-body-inner">{{ content | safe }}</div>
      </article>
    </section>
    <div class="mx-auto flex justify-center p-2">
      <a
        href="/"
        class="bg-sunflower-500 text-spring-950 hover:bg-sunflower-400 p-4 text-center transition-colors"
      >
        トップページへ戻る
      </a>
    </div>
    {% include 'footer.liquid' %}

    <!-- Legacy site toggle button -->
    <div
      x-data="{ show: false }"
      x-init="setTimeout(() => show = true, 500)"
      x-show="show"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-cloak
      class="fixed bottom-4 right-4 z-[9999]"
      style="position: fixed !important; bottom: 1rem !important; right: 1rem !important; z-index: 9999 !important;"
    >
      <a
        href="https://legacy.nitta-kashiho.com"
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-2 rounded-full bg-white/95 backdrop-blur-sm shadow-lg ring-1 ring-stone-200 px-3 py-2 text-xs font-medium text-stone-700 transition-all hover:bg-white hover:shadow-xl hover:ring-stone-300"
      >
        <span class="text-base">🏛️</span>
        <span>旧サイトを見る</span>
        <svg class="w-3 h-3 text-stone-400 group-hover:text-stone-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-10L10 14" />
        </svg>
      </a>
    </div>
  </body>
</html>
